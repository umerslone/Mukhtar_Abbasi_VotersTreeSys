# ---- Database (Neon Postgres) ----
DATABASE_URL="postgresql://USER:PWD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connection_limit=1"
DIRECT_URL="postgresql://USER:PWD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# ---- NextAuth ----
# In Vercel set NEXTAUTH_URL to your deployment URL e.g. https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="paste-output-of-openssl-rand-base64-32"

# ---- Staff login (Credentials provider) ----
STAFF_USERNAME="admin"
STAFF_PASSWORD_HASH=""   # bcrypt hash

# ---- Azure Document Intelligence (OCR) ----
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=""
AZURE_DOCUMENT_INTELLIGENCE_KEY=""

# ---- Azure OpenAI (Urdu cleanup) ----
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_DEPLOYMENT="gpt-4o-mini"
AZURE_OPENAI_API_VERSION="2024-10-21"

# ---- /ingest direct PDF/Image OCR ----
# The Next.js route /api/ocr-extract supports two engines:
#   ?engine=azure  (default) → calls Azure DI with the keys above.
#   ?engine=paddle           → proxies to the Flask service in
#                              voter_ocr_service/. Set OCR_SERVICE_URL
#                              when you self-host PaddleOCR on the same
#                              Droplet (or anywhere reachable):
OCR_SERVICE_URL=""   # e.g. http://127.0.0.1:5005 on a DO Droplet
