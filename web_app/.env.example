# ---- Database (Neon Postgres) ----
DATABASE_URL="postgresql://USER:PWD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connection_limit=1"
DIRECT_URL="postgresql://USER:PWD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# ---- NextAuth ----
# In Vercel set NEXTAUTH_URL to your deployment URL e.g. https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="paste-output-of-openssl-rand-base64-32"

# ---- Staff login (Credentials provider) ----
STAFF_USERNAME="admin"
STAFF_PASSWORD_HASH=""   # bcrypt hash

# ---- Azure Document Intelligence (OCR) ----
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=""
AZURE_DOCUMENT_INTELLIGENCE_KEY=""

# ---- Azure OpenAI (Urdu cleanup) ----
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_DEPLOYMENT="gpt-4o-mini"
AZURE_OPENAI_API_VERSION="2024-10-21"
