generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Voter {
  id                  String   @id @default(cuid())
  block_code          String
  serial_no           String
  name                String
  father_husband_name String
  cnic                String
  profession          String   @default("")
  age                 Int?
  address             String
  inferred_family_id  String
  gender              String?
  voter_status        String   @default("Unsurveyed")
  is_on_duty          Boolean  @default(false)
  tags                String[] @default([])
  source_batch        String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@index([inferred_family_id])
  @@index([block_code, address])
  @@index([cnic])
  @@index([name])
  @@index([source_batch])
}

/// Manual override of an inferred family relationship.
/// `decision = "confirmed"` locks an edge the operator vouched for;
/// `decision = "rejected"` hides a false-positive member from the ego's tree.
/// Records are scoped per (ego, member) pair so the same member can be
/// shown for one relative and hidden for another.
model FamilyOverride {
  id             String   @id @default(cuid())
  ego_voter_id   String
  member_voter_id String
  decision       String   // "confirmed" | "rejected"
  relation_hint  String?  // optional: parent | sibling | child | grandchild | other
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@unique([ego_voter_id, member_voter_id])
  @@index([ego_voter_id])
}
