# Copy to .env and edit
HOST=0.0.0.0
PORT=5005
FLASK_DEBUG=false

# CORS — comma-separated origins (use * only for local dev)
CORS_ORIGINS=http://localhost:3000,https://voters-tree-sys-abbasi.vercel.app

# PDF rendering
PDF_DPI=300
# Windows users: download Poppler and point here, e.g.:
# POPPLER_PATH=C:\poppler-24.07.0\Library\bin

# OCR
OCR_LANG=arabic
OCR_USE_GPU=false
OCR_WORKERS=2

# Upload limits
MAX_CONTENT_MB=100
